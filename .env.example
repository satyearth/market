# Local Server
PORT=8080

# Supabase Storage (Datasets & Daily Refresh)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_STORAGE_BUCKET=machii-bazzar-datasets
SUPABASE_ANON_KEY=<REDACTED_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<REDACTED_SUPABASE_SERVICE_ROLE_KEY>

# Production API Refresh Authorization (required when VERCEL=1 or NODE_ENV=production)
REFRESH_API_SECRET=<REDACTED_REFRESH_API_SECRET>

# Optional Daily Refresh Polling Controls
REFRESH_WAIT_MINUTES=15
REFRESH_POLL_SECONDS=30
